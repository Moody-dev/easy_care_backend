APP_NAME="EasyCare API Testing"
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8001
FRONTEND_URLS=*

# Direct database connection or the IPv4 session pooler from Supabase > Connect.
# API publishable/secret keys are not database credentials and are not needed.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=db.YOUR-PROJECT.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=easycare
DB_SSLMODE=verify-full
# Public Supabase Root 2021 CA; verify any future provider rotation before replacing it.
DB_SSLROOTCERT=bootstrap/certs/supabase-root-2021.crt

SESSION_DRIVER=database
SESSION_COOKIE=easycare_supabase_session
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
PROTECTED_FILES_ROOT="storage/app/supabase-preview/protected"
MAIL_MAILER=log
LOG_CHANNEL=single
LOG_LEVEL=warning
APP_MAINTENANCE_DRIVER=file
