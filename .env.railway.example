APP_NAME="EasyCare API Testing"
APP_ENV=production
APP_DEBUG=false
HOSTING_PLATFORM=railway
# Reuse the permanent APP_KEY from the existing private Supabase profile.
APP_KEY=
# Leave unset: startup derives HTTPS from Railway's generated public domain.
FRONTEND_URLS=*
TRUSTED_PROXIES=*

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=YOUR-SESSION-POOLER.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR-PROJECT
DB_PASSWORD=
DB_SCHEMA=easycare
DB_SSLMODE=verify-full
DB_SSLROOTCERT=bootstrap/certs/supabase-root-2021.crt

# Attach a Railway volume at /var/data before starting the service.
PERSISTENT_STORAGE_ROOT=/var/data
PROTECTED_FILES_ROOT=/var/data/protected
FILESYSTEM_DISK=local
SESSION_DRIVER=database
SESSION_COOKIE=easycare_supabase_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning
APP_MAINTENANCE_DRIVER=file
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=75
